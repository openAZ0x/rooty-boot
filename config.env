# Shared configuration for the signed-boot USB image build.
#
# Everything device-specific is a *path to content you supply yourself* (your
# own device's firmware) or a value you set below. This repository ships no
# firmware, no keys, no serials and no vendor content.
#
# Defaults target the Denon Prime 4+ (JC11S, ARMv7/armhf), the worked example.
# Other boards and firmware need separate verification; see docs/.

# ---------------------------------------------------------------------------
# Rootfs identity
#
# IMAGE_LABEL is both the ext4 filesystem label and the GPT partition name, and
# MUST match the root=PARTLABEL= reference in BOOTARGS. (The worked example's
# vendor kernel understands root=PARTLABEL=, not root=LABEL=.)
# ---------------------------------------------------------------------------
IMAGE_LABEL="${IMAGE_LABEL:-debian}"
[[ "$IMAGE_LABEL" =~ ^[a-zA-Z0-9_-]{1,16}$ ]] || {
  echo "IMAGE_LABEL must be 1-16 ASCII letters, digits, underscores or hyphens" >&2
  return 1
}
ROOTFS_IMG="$IMAGE_LABEL-root.img"

# ---------------------------------------------------------------------------
# Build tree. ROOT is this repository; everything else hangs off it so the
# checkout works from any location without editing this file.
# ---------------------------------------------------------------------------
ROOT="${ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)}"

ROOTFS_DIR="${ROOTFS_DIR:-$ROOT/rootfs}"
# A ready-made raw ext4 rootfs to boot instead of building one with
# debootstrap - for example the <image>-<machine>.rootfs.ext4 a Yocto build
# emits. When set, make-image.sh copies it, points /etc/fstab at
# PARTLABEL=$IMAGE_LABEL and grows the copy to the stick. OVERLAY_DIR is not
# applied (the image must already carry its own eMMC lockdown). See
# docs/meta-az0x.md.
ROOTFS_IMAGE="${ROOTFS_IMAGE:-}"
OVERLAY_DIR="${OVERLAY_DIR:-$ROOT/overlay}"      # optional: copied into the rootfs at image time
SAFETY_OVERLAY_DIR="${SAFETY_OVERLAY_DIR:-$ROOT/vendor/rootfs-overlay}"
IMAGES_OUT="${IMAGES_OUT:-$ROOT/images}"
FIRMWARE_CACHE_DIR="${FIRMWARE_CACHE_DIR:-$ROOT/cache/firmware}"

# ---------------------------------------------------------------------------
# Firmware inputs - you provide these, taken from your own device's update.
# See docs/boot-mechanism.md for what each one is.
#
#   KERNEL_ITB      the signed vendor `kernel.fit` (FIT image)
#   RESTORE_IMG_SRC a pristine copy of the stock `kernel` partition (recovery)
#   TAMPER_PY       the CVE-2026-46728 cmdline-tamper tool (vendored copy in
#                   vendor/tamper/; override only for a different version)
#
# The easy path is to set FIRMWARE_IMG to the official update file (a local
# path or an HTTPS URL) matching the version ALREADY FLASHED on the device. It
# is downloaded (URLs), verified (per-partition SHA-256) and unpacked into
# cache/firmware/<name>/. kernel.fit + kernel.img feed make-kernel.sh; rootfs.img
# feeds the vendor kernel-support import. Already-extracted caches are reused.
# Version matters: see the version-matching warning in docs/flashing.md.
# ---------------------------------------------------------------------------
FIRMWARE_IMG="${FIRMWARE_IMG:-}"
KERNEL_ITB="${KERNEL_ITB:-}"
RESTORE_IMG_SRC="${RESTORE_IMG_SRC:-}"
TAMPER_PY="${TAMPER_PY:-$ROOT/vendor/tamper/tamper_cmdline.py}"

# Optional unsigned FIT from a meta-az0x build. When set, make-kernel.sh
# replaces the kernel and board DTB too, not just bootargs. Experimental:
# validate on a serial console before relying on it. The signed vendor FIT is
# still required as the base.
CUSTOM_FIT="${CUSTOM_FIT:-}"
BOARD="${BOARD:-rk3288-az01-jc11s}"
# JC11S's GPT kernel slot is 16 MiB. The stock repack keeps the original
# artifact size; the custom-kernel route uses this larger slot. flash-kernel
# checks the actual device partition size before writing.
KERNEL_PARTITION_MIB="${KERNEL_PARTITION_MIB:-16}"

# ---------------------------------------------------------------------------
# Vendor kernel support (Debian path only)
#
# The vendor (Engine OS) rootfs - an ext2/3/4 image or an extracted directory -
# is the source of everything the vendor kernel does not have built in.
# tools/import-vendor-support.sh (run by build-rootfs.sh) copies
# /lib/modules/$KVERSION, /lib/firmware, the modprobe.d dropins and a small
# allowlist of udev rules out of it. Leave empty only if the kernel really has
# everything built in.
# ---------------------------------------------------------------------------
MODULES_SRC="${MODULES_SRC:-}"
# Kernel module version present in the device rootfs (must equal `uname -r`).
KVERSION="${KVERSION:-}"
# Self-contained vendor udev rules to import (space separated, "none" to skip).
# Rules that spawn vendor services are not portable; add those via overlay/.
VENDOR_UDEV_RULES="${VENDOR_UDEV_RULES:-01-pl330-autosuspend.rules}"

# ---------------------------------------------------------------------------
# Boot arguments. These are what changes in both workflows, via the fdt-cmdline
# overlay. The console= line is the one part that is genuinely per-board
# (worked example: console=ttyS3,115200n8 on the Prime 4+ UART3 header).
# ---------------------------------------------------------------------------
BOOTARGS="${BOOTARGS:-root=PARTLABEL=$IMAGE_LABEL rootwait rw console=ttyS3,115200n8 loglevel=4}"

# ---------------------------------------------------------------------------
# Yocto (meta-az0x). Builds run in an EXISTING, configured build tree; rooty-boot
# does not clone layers or set up a distro.
# ---------------------------------------------------------------------------
YOCTO_BUILD_DIR="${YOCTO_BUILD_DIR:-}"
YOCTO_INIT="${YOCTO_INIT:-}"
YOCTO_MACHINE="${YOCTO_MACHINE:-az0x-signed}"
YOCTO_IMAGE="${YOCTO_IMAGE:-core-image-minimal}"
YOCTO_PROVIDER="${YOCTO_PROVIDER:-yocto-rt}"
YOCTO_DEPLOY_DIR="${YOCTO_DEPLOY_DIR:-${YOCTO_BUILD_DIR:+$YOCTO_BUILD_DIR/tmp/deploy/images/$YOCTO_MACHINE}}"

# ---------------------------------------------------------------------------
# Device writes. Always separate from builds: set CONFIRM=YES to opt in.
# fastboot writes also require SERIAL; USB writes require USB_DEVICE.
# ---------------------------------------------------------------------------
CONFIRM="${CONFIRM:-}"
SERIAL="${SERIAL:-}"
USB_DEVICE="${USB_DEVICE:-}"

# ---------------------------------------------------------------------------
# Debian target (optional rootfs; see docs/building.md)
# ---------------------------------------------------------------------------
ARCH="${ARCH:-armhf}"
DISTRO="${DISTRO:-trixie}"
MIRROR="${MIRROR:-http://deb.debian.org/debian}"

# Root password for the built rootfs. Required; build-rootfs.sh refuses an
# empty value. There is deliberately no default: pick one before building.
ROOT_PASSWORD="${ROOT_PASSWORD:-}"
APPLIANCE_HOSTNAME="${APPLIANCE_HOSTNAME:-usb-boot}"

# ---------------------------------------------------------------------------
# Stick geometry. 4 GiB is roomy for a headless rootfs.
# ---------------------------------------------------------------------------
STICK_SIZE_MB="${STICK_SIZE_MB:-4096}"

# chroot / build parallelism for qemu-user (each job is an emulated process)
JOBS="${JOBS:-8}"
